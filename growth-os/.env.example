# Growth OS configuration. Copy to .env — never commit real values.
# (see Database section below)

# Main NiwasNest app (read-only by default). Use a dedicated staff account, not the founder's.
NIWASNEST_API_BASE=https://api.niwasnest.com
NIWASNEST_API_TOKEN=
# Set to "true" only after founder approval. Even then only lead-creation and claim-link calls are allowed.
NIWASNEST_API_WRITES_ENABLED=false

# LLM (model-independent; gemini | mock)
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Global emergency stop. "true" blocks every agent side effect.
AGENTS_KILL_SWITCH=false

# Database (pick one). Production: direct Postgres connection string from Supabase → Connect.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# Admin/CLI alternative via Supabase Management API:
SUPABASE_PROJECT_REF=rznsuobewwmmvbvfatuc
SUPABASE_ACCESS_TOKEN=
